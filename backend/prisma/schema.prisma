// TrustPass — schéma Prisma. Dérivé de docs/DB_SCHEMA.md.
// Montants en centimes (Int). Devise EUR par défaut.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  buyer
  seller
  organizer
  controller
  admin
}

enum TicketStatus {
  owned
  listed
  reserved
  sold
  used
  invalidated
}

enum ListingStatus {
  active
  reserved
  sold
  withdrawn
  expired
}

enum OrderStatus {
  pending
  paid
  transferred
  failed
  refunded
}

enum TransferKind {
  purchase // revente via la marketplace (déclenchée par paiement)
  gift     // don nominatif direct entre particuliers
}

enum AuditAction {
  ticket_attach
  listing_publish
  listing_withdraw
  reservation_create
  reservation_expire
  payment_succeeded
  payment_failed
  ownership_transfer
  qr_invalidate
  entry_scan
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String    @map("password_hash")
  role            UserRole  @default(buyer)
  emailVerifiedAt DateTime? @map("email_verified_at")
  stripeAccountId String?   @map("stripe_account_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  events        Event[]        @relation("OrganizerEvents")
  tickets       Ticket[]       @relation("TicketOwner")
  listings      Listing[]      @relation("SellerListings")
  orders        Order[]        @relation("BuyerOrders")
  auditLogs     AuditLog[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model Event {
  id          String   @id @default(uuid())
  organizerId String   @map("organizer_id")
  name        String
  venue       String?
  startsAt    DateTime @map("starts_at")
  imageUrl    String?  @map("image_url") // affiche de l'événement (URL ou data URL compressé)
  externalRef String?  @map("external_ref")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  organizer   User            @relation("OrganizerEvents", fields: [organizerId], references: [id])
  ticketTypes TicketType[]
  rules       OrganizerRule[]
  tickets     Ticket[]

  @@index([organizerId])
  @@index([startsAt])
  @@map("events")
}

model TicketType {
  id        String   @id @default(uuid())
  eventId   String   @map("event_id")
  name      String
  faceValue Int      @map("face_value")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  event   Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rules   OrganizerRule[]
  tickets Ticket[]

  @@map("ticket_types")
}

model OrganizerRule {
  id             String    @id @default(uuid())
  eventId        String    @map("event_id")
  ticketTypeId   String?   @map("ticket_type_id")
  priceCap       Int       @map("price_cap")
  resaleOpensAt  DateTime? @map("resale_opens_at")
  resaleClosesAt DateTime? @map("resale_closes_at")
  commissionBps  Int       @default(500) @map("commission_bps")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType TicketType? @relation(fields: [ticketTypeId], references: [id])

  @@unique([eventId, ticketTypeId])
  @@map("organizer_rules")
}

model Ticket {
  id           String       @id @default(uuid())
  eventId      String       @map("event_id")
  ticketTypeId String?      @map("ticket_type_id")
  ownerId      String       @map("owner_id")
  status       TicketStatus @default(owned)
  qrCode       String       @unique @map("qr_code")
  qrVersion    Int          @default(1) @map("qr_version")
  reference    String?      @map("reference") // n° de référence lisible (hors QR), régénéré à chaque transfert
  externalRef  String?      @unique @map("external_ref") // réf billetterie source (attach idempotent)
  holderName   String?      @map("holder_name")  // porteur nominatif (transfert direct entre particuliers)
  holderEmail  String?      @map("holder_email")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  event      Event       @relation(fields: [eventId], references: [id])
  ticketType TicketType? @relation(fields: [ticketTypeId], references: [id])
  owner      User        @relation("TicketOwner", fields: [ownerId], references: [id])
  listings   Listing[]
  transfers  Transfer[]

  @@index([ownerId])
  @@index([eventId])
  @@index([status])
  @@map("tickets")
}

model Listing {
  id            String        @id @default(uuid())
  ticketId      String        @map("ticket_id")
  sellerId      String        @map("seller_id")
  price         Int
  status        ListingStatus @default(active)
  reservedBy    String?       @map("reserved_by")
  reservedUntil DateTime?     @map("reserved_until")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  ticket Ticket  @relation(fields: [ticketId], references: [id])
  seller User    @relation("SellerListings", fields: [sellerId], references: [id])
  orders Order[]

  // NB: l'unicité "1 annonce vivante par billet" (status active|reserved) est un
  // index partiel PostgreSQL à ajouter dans la migration :
  //   CREATE UNIQUE INDEX listings_ticket_alive
  //     ON listings (ticket_id) WHERE status IN ('active','reserved');
  @@index([status])
  @@index([ticketId])
  @@index([reservedBy])
  @@map("listings")
}

model Order {
  id                     String      @id @default(uuid())
  listingId              String      @map("listing_id")
  buyerId                String      @map("buyer_id")
  sellerId               String      @map("seller_id")
  amount                 Int
  commission             Int
  currency               String      @default("EUR")
  status                 OrderStatus @default(pending)
  stripePaymentIntentId  String?     @unique @map("stripe_payment_intent_id")
  idempotencyKey         String      @unique @map("idempotency_key")
  createdAt              DateTime    @default(now()) @map("created_at")
  updatedAt              DateTime    @updatedAt @map("updated_at")

  listing  Listing   @relation(fields: [listingId], references: [id])
  buyer    User      @relation("BuyerOrders", fields: [buyerId], references: [id])
  transfer Transfer?

  @@index([buyerId])
  @@index([listingId])
  @@index([status])
  @@map("orders")
}

model Transfer {
  id           String       @id @default(uuid())
  orderId      String?      @unique @map("order_id") // null pour un don nominatif (hors marketplace)
  ticketId     String       @map("ticket_id")
  kind         TransferKind @default(purchase)
  fromUserId   String       @map("from_user_id")
  toUserId     String?      @map("to_user_id")       // null si destinataire sans compte
  toHolderName String?      @map("to_holder_name")   // nom du porteur nominatif
  toEmail      String?      @map("to_email")
  oldQrCode    String       @map("old_qr_code")
  newQrCode    String       @map("new_qr_code")
  createdAt    DateTime     @default(now()) @map("created_at")

  order  Order?  @relation(fields: [orderId], references: [id])
  ticket Ticket  @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
  @@map("transfers")
}

model StripeEvent {
  id          String    @id
  type        String
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("stripe_events")
}

model AuditLog {
  id         String      @id @default(uuid())
  actorId    String?     @map("actor_id")
  action     AuditAction
  targetType String      @map("target_type")
  targetId   String      @map("target_id")
  amount     Int?
  metadata   Json?
  createdAt  DateTime    @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id])

  @@index([targetType, targetId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_log")
}
