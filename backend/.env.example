# Backend TrustPass — variables d'environnement (exemple). Ne jamais committer le vrai .env.
NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trustpass?schema=public"

# Redis (cache, réservations, queue)
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="change-me"
JWT_REFRESH_SECRET="change-me-too"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# Stripe Connect
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Réservation d'annonce (TTL en secondes) — cf. ADR-002
RESERVATION_TTL_SECONDS=600

# Emails transactionnels (Resend). Vide = mode dev (emails loggés, non envoyés).
RESEND_API_KEY=""
EMAIL_FROM="TrustPass <noreply@trustpass.dev>"

# CORS
CORS_ORIGIN="http://localhost:5173"
